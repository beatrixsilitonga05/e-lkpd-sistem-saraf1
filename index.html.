  <script>const STORAGE_KEY = 'jejak-impuls:v1';
const MEDIA = {
  cover: "data:image/svg+xml;base64,",
  health: "data:image/svg+xml;base64,"
};
const initialState = {student:{name:'',group:''},answers:{},completed:{},rubric:{},lastSaved:null};
let state = loadState();
let currentPage = 'home';
let toastTimer;

function loadState(){
  try { const raw = localStorage.getItem(STORAGE_KEY); if(raw){ const s=JSON.parse(raw); return {...initialState,...s,student:{...initialState.student,...s.student},answers:s.answers||{},completed:s.completed||{},rubric:s.rubric||{}}; } }
  catch(e){ console.warn('Penyimpanan lokal tidak tersedia; sesi ini tetap dapat digunakan.',e); }
  return structuredClone(initialState);
}
function saveState(){
  state.lastSaved = new Date().toISOString();
  try { localStorage.setItem(STORAGE_KEY,JSON.stringify(state)); setConnectivity(); }
  catch(e){ setConnectivity('memory'); }
}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function val(key){return state.answers[key]||'';}
function answer(key,label,placeholder='',rows='short'){
  return `<div class="response-block"><label for="${key}">${label}</label><textarea class="text-area ${rows}" id="${key}" data-answer="${key}" placeholder="${esc(placeholder)}">${esc(val(key))}</textarea></div>`;
}
function inputField(key,label,placeholder=''){
  const current=key==='profile.name'?state.student.name:key==='profile.group'?state.student.group:val(key);
  return `<label><span class="field-label">${label}</span><input class="text-input" data-answer="${key}" value="${esc(current)}" placeholder="${esc(placeholder)}"></label>`;
}
function selectField(key,label,options){
  return `<label><span class="field-label">${label}</span><select class="select-input" data-answer="${key}"><option value="">Pilih jawaban…</option>${options.map(o=>`<option value="${esc(o[0])}" ${val(key)===o[0]?'selected':''}>${esc(o[1])}</option>`).join('')}</select></label>`;
}
function phase(n,title,subtitle,body){return `<section class="phase-card"><div class="phase-title"><span class="phase-number">${String(n).padStart(2,'0')}</span><div><h3>${title}</h3><p>${subtitle}</p></div></div>${body}</section>`;}
function quickCheck(id,question,options,correct,explain){
 return `<div class="quick-check"><strong>Cek cepat · latihan formatif</strong><p>${question}</p><div class="check-row"><select class="select-input" id="pick-${id}" aria-label="Pilih jawaban untuk cek cepat"><option value="">Pilih jawaban…</option>${options.map((o,i)=>`<option value="${i}">${o}</option>`).join('')}</select><button class="button button-primary button-small" type="button" data-check="${id}">Periksa</button></div><div class="feedback" id="feedback-${id}" aria-live="polite"></div></div>`;
}
function neuronSvg(){return `<figure class="visual-card"><svg viewBox="0 0 900 320" role="img" aria-labelledby="neuron-title neuron-desc"><title id="neuron-title">Skema neuron dan arah informasi</title><desc id="neuron-desc">Dendrit menuju badan sel, akson berselubung mielin dengan nodus Ranvier di celah antarsegmen, lalu berakhir di terminal akson.</desc><defs><marker id="arrN" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9z" fill="#087f83"/></marker></defs><rect width="900" height="320" rx="18" fill="#f4f8f5"/><g stroke="#087f83" stroke-width="8" stroke-linecap="round" fill="none"><path d="M180 160C126 127 115 95 90 65M177 158C119 161 100 148 58 138M180 163C128 193 112 230 78 259M188 153C170 102 176 68 166 42M225 160C340 159 422 160 544 160"/><path d="M600 160C674 160 707 157 758 157" stroke-width="5"/></g><g fill="#b7d5cc" stroke="#087f83" stroke-width="4"><ellipse cx="348" cy="160" rx="27" ry="18"/><ellipse cx="416" cy="160" rx="27" ry="18"/><ellipse cx="484" cy="160" rx="27" ry="18"/></g><circle cx="202" cy="158" r="55" fill="#f3bd65" stroke="#d7894b" stroke-width="4"/><circle cx="202" cy="158" r="16" fill="#fff6df" stroke="#d7894b" stroke-width="3"/><g fill="#087f83"><circle cx="777" cy="156" r="8"/><circle cx="795" cy="137" r="7"/><circle cx="797" cy="175" r="7"/></g><g font-family="system-ui,sans-serif" font-size="17" font-weight="700" fill="#26444b"><text x="42" y="35">DENDRIT</text><text x="157" y="248">BADAN SEL</text><text x="365" y="214">AKSON</text><text x="360" y="104">SELUBUNG MIELIN</text><text x="530" y="124">NODUS RANVIER</text><text x="696" y="220">TERMINAL AKSON</text><text x="485" y="280" fill="#087f83">Arah impuls ?</text></g><g stroke="#7f9993" stroke-width="2"><path d="M97 42L111 88M200 229L201 216M410 196L410 178M442 116L438 139M450 143L518 128M755 199L778 170"/></g><path d="M260 282H713" stroke="#087f83" stroke-width="4" stroke-dasharray="6 9" marker-end="url(#arrN)"/></svg><figcaption>Model konseptual: informasi umumnya diterima melalui dendrit, diproses di badan sel, lalu dihantarkan melalui akson menuju terminal.</figcaption></figure>`;}
function synapseSvg(){return `<figure class="visual-card"><svg viewBox="0 0 800 340" role="img" aria-labelledby="syn-title syn-desc"><title id="syn-title">Tahap komunikasi pada sinapsis kimia</title><desc id="syn-desc">Impuls sampai di terminal akson, neurotransmiter dilepas ke celah sinaptik, lalu berikatan dengan reseptor pada sel berikutnya.</desc><defs><marker id="arrS" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9z" fill="#087f83"/></marker></defs><rect width="800" height="340" rx="18" fill="#f4f8f5"/><path d="M0 75Q120 60 195 82Q244 99 260 141L260 222Q240 260 190 274Q110 291 0 278Z" fill="#d9ebe3" stroke="#83afa0" stroke-width="4"/><path d="M800 77Q674 61 607 82Q559 98 542 140L542 222Q560 259 609 274Q685 291 800 277Z" fill="#e2edf2" stroke="#92b1c1" stroke-width="4"/><rect x="257" y="95" width="286" height="150" rx="25" fill="#fff" stroke="#e0c88f" stroke-width="3"/><text x="66" y="50" font-family="system-ui" font-size="18" font-weight="700" fill="#26444b">NEURON PENGIRIM</text><text x="583" y="50" font-family="system-ui" font-size="18" font-weight="700" fill="#26444b">SEL PENERIMA</text><text x="317" y="78" font-family="system-ui" font-size="15" fill="#607570">celah sinaptik</text><g fill="#f2bf64" stroke="#b9813e" stroke-width="2"><circle cx="292" cy="151" r="12"/><circle cx="325" cy="182" r="12"/><circle cx="367" cy="146" r="12"/><circle cx="405" cy="197" r="12"/><circle cx="449" cy="152" r="12"/><circle cx="493" cy="188" r="12"/></g><g fill="#087f83"><path d="M581 140v44h21v-44z"/><path d="M628 140v44h21v-44z"/><path d="M675 140v44h21v-44z"/><path d="M722 140v44h21v-44z"/></g><path d="M58 169H198" stroke="#087f83" stroke-width="6" marker-end="url(#arrS)"/><path d="M274 298H523" stroke="#087f83" stroke-width="3" stroke-dasharray="6 8" marker-end="url(#arrS)"/><text x="55" y="317" font-family="system-ui" font-size="14" fill="#35525d">Impuls tiba</text><text x="280" y="317" font-family="system-ui" font-size="14" fill="#35525d">Neurotransmiter melintasi celah</text><text x="583" y="230" font-family="system-ui" font-size="14" fill="#35525d">reseptor</text><path d="M620 222L639 179" stroke="#607570" stroke-width="2"/></svg><figcaption>Urutan konseptual sinapsis kimia. Peristiwa molekuler lebih rinci tidak digambarkan.</figcaption></figure>`;}
function reflexSvg(){return `<figure class="visual-card"><svg viewBox="0 0 900 290" role="img" aria-labelledby="ref-title ref-desc"><title id="ref-title">Lengkung refleks menarik tangan dari benda panas</title><desc id="ref-desc">Reseptor kulit membawa sinyal melalui neuron sensorik ke sumsum tulang belakang; neuron motorik mengirim perintah ke otot. Informasi juga diteruskan ke otak.</desc><defs><marker id="arrR" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0 0L9 4.5L0 9z" fill="#087f83"/></marker></defs><rect width="900" height="290" rx="18" fill="#f4f8f5"/><g font-family="system-ui" text-anchor="middle"><g><circle cx="90" cy="133" r="39" fill="#ffe3cc" stroke="#e99c70" stroke-width="3"/><text x="90" y="127" font-size="13" font-weight="700" fill="#26444b">RESEPTOR</text><text x="90" y="146" font-size="11" fill="#55716e">kulit</text></g><g><rect x="222" y="93" width="145" height="80" rx="18" fill="#e3f0eb" stroke="#7fac9f" stroke-width="3"/><text x="294" y="125" font-size="14" font-weight="700" fill="#26444b">NEURON</text><text x="294" y="146" font-size="12" fill="#55716e">sensorik</text></g><g><rect x="425" y="66" width="155" height="133" rx="35" fill="#f7e7c6" stroke="#d8ad5c" stroke-width="3"/><text x="502" y="119" font-size="14" font-weight="700" fill="#26444b">SUMSUM</text><text x="502" y="141" font-size="14" font-weight="700" fill="#26444b">TULANG</text><text x="502" y="163" font-size="14" font-weight="700" fill="#26444b">BELAKANG</text></g><g><rect x="640" y="93" width="145" height="80" rx="18" fill="#e3f0eb" stroke="#7fac9f" stroke-width="3"/><text x="712" y="125" font-size="14" font-weight="700" fill="#26444b">NEURON</text><text x="712" y="146" font-size="12" fill="#55716e">motorik</text></g><g><circle cx="838" cy="133" r="39" fill="#ffd6c8" stroke="#e58a70" stroke-width="3"/><text x="838" y="128" font-size="13" font-weight="700" fill="#26444b">EFEKTOR</text><text x="838" y="146" font-size="11" fill="#55716e">otot</text></g></g><g fill="none" stroke="#087f83" stroke-width="5" marker-end="url(#arrR)"><path d="M130 133H213"/><path d="M370 133H414"/><path d="M591 133H630"/><path d="M790 133H798"/></g><path d="M500 62Q495 20 536 20H679" fill="none" stroke="#ee8b69" stroke-width="3" stroke-dasharray="7 7" marker-end="url(#arrR)"/><text x="597" y="15" font-family="system-ui" font-size="12" fill="#9c573f" text-anchor="middle">informasi juga menuju otak</text><text x="450" y="253" font-family="system-ui" font-size="14" fill="#35525d" text-anchor="middle">Jalur cepat ? perintah motorik dapat dimulai di sumsum; otak tetap menerima informasi.</text></svg><figcaption>Skema sederhana lengkung refleks. Jalur sebenarnya bergantung pada jenis rangsangan dan respons.</figcaption></figure>`;}
function brainSvg(){return `<figure class="visual-card"><svg viewBox="0 0 720 310" role="img" aria-labelledby="brain-title brain-desc"><title id="brain-title">Pusat dan tepi sistem saraf</title><desc id="brain-desc">Otak dan sumsum tulang belakang menyusun sistem saraf pusat. Saraf di luar keduanya termasuk sistem saraf tepi.</desc><rect width="720" height="310" rx="18" fill="#f4f8f5"/><g><path d="M190 90C176 46 215 26 251 40C271 10 319 27 324 55C360 61 364 108 335 125C339 162 294 170 272 148C247 168 213 150 216 124C190 123 178 107 190 90Z" fill="#f2bf64" stroke="#cc9651" stroke-width="4"/><path d="M274 147C268 180 274 208 270 256" stroke="#e18d69" stroke-width="15" stroke-linecap="round"/><path d="M272 196L220 232M273 195L324 231M270 227L239 269M270 227L306 268" stroke="#087f83" stroke-width="7" stroke-linecap="round"/><text x="272" y="293" font-family="system-ui" font-size="14" font-weight="700" fill="#26444b" text-anchor="middle">SISTEM SARAF PUSAT</text><text x="484" y="98" font-family="system-ui" font-size="18" font-weight="700" fill="#26444b">OTAK + SUMSUM TULANG BELAKANG</text><text x="484" y="126" font-family="system-ui" font-size="14" fill="#55716e">mengintegrasikan informasi</text><path d="M475 145H644" stroke="#b5c8c0" stroke-width="2"/><text x="484" y="181" font-family="system-ui" font-size="18" font-weight="700" fill="#087f83">SISTEM SARAF TEPI</text><text x="484" y="209" font-family="system-ui" font-size="14" fill="#55716e">saraf di luar pusat;</text><text x="484" y="233" font-family="system-ui" font-size="14" fill="#55716e">menghubungkan reseptor, pusat,</text><text x="484" y="257" font-family="system-ui" font-size="14" fill="#55716e">dan efektor</text></g></svg><figcaption>Klasifikasi dasar: sistem saraf pusat (SSP) dan sistem saraf tepi (SST).</figcaption></figure>`;}

