 <section class="notice"><b>Identitas Penelitian:</b> E-LKPD ini dikembangkan dalam rangka Tugas Akhir Skripsi oleh <b>Beatrix Octaviana Silitonga</b> (NIM 4233141016), Program Studi Pendidikan Biologi, Jurusan Biologi, FMIPA, Universitas Negeri Medan (UNIMED), di bawah bimbingan Prof. Dr. Melva Silitonga, M.S.</section>`;
}
function asideFor(id,u){const done=!!state.completed[id];return `<aside class="unit-aside"><section class="aside-card"><span class="section-kicker">TARGET HARI INI</span><h3>Tujuan belajar</h3><p>${u.objective}</p><div class="timer"><span>Estimasi</span><strong>${u.time}</strong></div><div class="deep-pill-row"><span class="deep-pill">Mindful</span><span class="deep-pill meaning">Meaningful</span><span class="deep-pill joy">Joyful</span></div></section><section class="aside-card"><span class="section-kicker">BUKTI BELAJAR</span><h3>Indikator konsep</h3><ul>${u.indicators.map(x=>`<li>${x}</li>`).join('')}</ul></section><section class="aside-card"><span class="section-kicker">PROGRES MISI</span><div class="progress-track"><span style="width:${done?'100':'0'}%"></span></div><p style="margin-top:9px">${done?'Kegiatan ditandai selesai. Kamu tetap bisa mengedit jawaban.':'Tandai selesai setelah meninjau jawabanmu.'}</p><button class="completion-toggle ${done?'done':''}" data-complete="${id}" type="button">${done?'? Selesai · klik untuk batalkan':'? Tandai kegiatan selesai'}</button><button class="button button-primary button-small aside-next" data-nav="${nextPage(id)}" type="button">${nextPage(id)==='teacher'?'Lihat rubrik':'Misi berikutnya'} ?</button></section></aside>`;}
function nextPage(id){const keys=Object.keys(units);return keys[keys.indexOf(id)+1]||'teacher';}
function renderUnit(id){const u=units[id];return `<div class="unit-head"><div><div class="breadcrumb">Jejak Impuls / ${u.meeting}</div><h1>${u.title}</h1><p>${u.subtitle}</p></div><span class="unit-chip"><span>${u.number}</span> ${u.time}</span></div><div class="unit-grid"><div class="worksheet"><section class="problem-card"><span class="eyebrow">KASUS PEMANTIK</span><h2>${u.title==='Kenali neuron'?'Satu sentuhan, satu pesan.':u.title==='Telusuri impuls & sinapsis'?'Bagaimana pesan menyeberang?':u.title==='Refleks atau sadar?'?'Respons cepat—apa jalurnya?':'Saring klaim sebelum membagikan.'}</h2><p>${u.problem}</p><div class="objective-row">${u.indicators.map(i=>`<span class="objective-tag">${i}</span>`).join('')}</div></section>${u.phases.map((p,i)=>phase(i+1,p.title,p.sub,p.body)).join('')}<div class="next-row"><button class="button button-outline" data-nav="${id==='lkpd1'?'home':Object.keys(units)[Object.keys(units).indexOf(id)-1]}" type="button">? Kembali</button><button class="button button-primary" data-nav="${nextPage(id)}" type="button">Lanjutkan jejak ?</button></div></div>${asideFor(id,u)}</div>`;}
const productRows=[
 ['Ketepatan konsep',['Semua konsep tepat dan hubungan logis.','Hampir semua tepat; ada kekeliruan kecil.','Beberapa konsep benar tetapi hubungan kurang jelas.','Konsep dominan keliru/tidak lengkap.']],
 ['Penggunaan bukti',['=2 bukti relevan dan menyebutkan sumber.','Bukti relevan tetapi sumber kurang lengkap.','Bukti terbatas atau kurang terkait.','Tidak menggunakan bukti.']],
 ['Pemecahan masalah',['Solusi spesifik, realistis, dan beralasan.','Solusi sesuai tetapi alasan belum mendalam.','Solusi umum dan kurang terhubung kasus.','Tidak ada solusi/solusi tidak sesuai.']],
 ['Komunikasi visual',['Jelas, runtut, mudah dibaca, kreatif.','Jelas dengan sedikit bagian padat.','Sulit dibaca pada beberapa bagian.','Tidak runtut/tidak terbaca.']]
];
const processRows=[
 ['Kolaborasi',['Peran seimbang, mendengar, membantu, dan menghargai.','Bekerja sama dengan sedikit arahan.','Kerja sama belum konsisten.','Menghambat/tidak berkontribusi.']],
 ['Komunikasi',['Argumen jelas; menanggapi berbasis bukti.','Penjelasan cukup jelas.','Penjelasan masih deskriptif.','Tidak mampu menjelaskan.']],
 ['Refleksi',['Mengidentifikasi keberhasilan, kendala, dan perbaikan konkret.','Refleksi cukup relevan.','Refleksi singkat dan umum.','Tidak mengisi refleksi.']]
];
function rubricTable(rows,prefix){return `<div class="table-wrap"><table class="rubric-table"><thead><tr><th>Aspek</th><th>4 · Mantap</th><th>3 · Berkembang</th><th>2 · Perlu dukungan</th><th>1 · Mulai</th><th>Skor</th></tr></thead><tbody>${rows.map(([name,levels],i)=>`<tr><td>${name}</td>${levels.map((x,j)=>`<td>${x}</td>`).join('')}<td class="rubric-score"><select class="select-input" data-rubric="${prefix}${i}" aria-label="Skor ${name}"><option value="">—</option>${[1,2,3,4].map(n=>`<option value="${n}" ${String(state.rubric[prefix+i]||'')===String(n)?'selected':''}>${n}</option>`).join('')}</select></td></tr>`).join('')}</tbody></table></div>`;}
function renderTeacher(){return `<section class="teacher-head"><span class="eyebrow">PENDAMPING PEMBELAJARAN</span><h1>Rubrik, refleksi &amp; catatan guru</h1><p>Alat bantu formatif yang mengikuti rancangan proposal skripsi Beatrix Octaviana Silitonga (UNIMED). Pilih skor kinerja yang teramati, lalu diskusikan umpan balik. Penilaian akhir tetap mengikuti keputusan guru dan pedoman sekolah.</p></section><div class="teacher-grid"><section class="teacher-card"><span class="section-kicker">RUBRIK PRODUK · SKALA 1–4</span><h2>Peta konsep, diagram, infografis</h2><p>Pilih skor berdasarkan bukti produk. Semua deskriptor merujuk rubrik Lampiran proposal.</p>${rubricTable(productRows,'produk-')}<div class="rating-summary" id="product-score">Pilih skor pada setiap aspek untuk melihat ringkasan.</div></section><section class="teacher-card"><span class="section-kicker">RUBRIK PROSES PBL · SKALA 1–4</span><h2>Kolaborasi &amp; komunikasi</h2><p>Amati proses, bukan hanya hasil akhir.</p>${rubricTable(processRows,'proses-')}<div class="rating-summary" id="process-score">Pilih skor pada setiap aspek untuk melihat ringkasan.</div></section><section class="teacher-card"><span class="section-kicker">KKTP · SESUAI PROPOSAL</span><h2>Interpretasi capaian</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Rentang</th><th>Kategori</th><th>Gambaran umum</th></tr></thead><tbody><tr><td>86–100</td><td><b>Sangat baik</b></td><td>Konsep tepat-lengkap, hubungan struktur–fungsi–respons kuat, menggunakan bukti dan memberi rekomendasi realistis.</td></tr><tr><td>76–85</td><td><b>Baik</b></td><td>Konsep mayoritas tepat; analisis dan solusi sesuai dengan sedikit kekeliruan nonmendasar.</td></tr><tr><td>66–75</td><td><b>Cukup</b></td><td>Konsep dasar dipahami; hubungan antarkonsep dan penggunaan bukti masih perlu bimbingan.</td></tr><tr><td>&lt;66</td><td><b>Perlu bimbingan</b></td><td>Miskonsepsi dominan; gunakan diagram, contoh konkret, dan pendampingan.</td></tr></tbody></table></div><p class="small-muted">KKTP ini mengikuti lampiran perangkat; sesuaikan dengan keputusan guru/sekolah.</p></section><section class="teacher-card"><span class="section-kicker">ANALISIS DATA PENELITIAN</span><h2>Kalkulator N-Gain</h2><p>Masukkan skor riil pretest dan posttest (0 sampai skor maksimum). Jangan gunakan kalkulator ini untuk mengarang hasil penelitian.</p><div class="calculator"><div class="calculator-grid">${inputField('ngain.pre','Skor pretest','0–100')}${inputField('ngain.post','Skor posttest','0–100')}${inputField('ngain.max','Skor maksimum','100')}</div><button class="button button-primary button-small" data-action="ngain" type="button" style="margin-top:11px">Hitung N-Gain</button><div class="calc-result" id="ngain-result" aria-live="polite">g = (posttest - pretest) ÷ (skor maksimum - pretest)</div></div><p class="small-muted">Kategori proposal: tinggi =0,70; sedang 0,30=g&lt;0,70; rendah g&lt;0,30. N-Gain menggambarkan peningkatan ternormalisasi; interpretasikan sesuai desain dan data, bukan sebagai bukti sebab-akibat tunggal.</p></section><section class="teacher-card wide"><span class="section-kicker">ALUR PELAKSANAAN</span><h2>Ringkas sebelum digunakan</h2><div class="teacher-grid"><div><p><b>Sebelum kegiatan.</b> Jelaskan tujuan/kriteria, cek gawai atau siapkan alternatif cetak, sepakati kerja aman, bentuk kelompok heterogen, dan tentukan peran. Instrumen pretest/posttest penelitian tetap gunakan versi yang disetujui pembimbing, terpisah dari latihan formatif dalam E-LKPD.</p><p><b>Selama kegiatan.</b> Minta siswa memisahkan fakta dari dugaan, merujuk model/sumber, berbagi peran dan mengomunikasikan alasan. Beri dukungan diagram/glosarium atau pengayaan sesuai kebutuhan.</p></div><div><p><b>Sesudah kegiatan.</b> Gunakan rubrik sebagai umpan balik formatif, beri waktu memperbaiki miskonsepsi, dan arahkan refleksi/transfer. Jangan unggah nama atau jawaban siswa ke tempat publik tanpa prosedur dan izin yang sesuai.</p><p><b>Batas keselamatan.</b> Konten kesehatan bersifat edukasi umum, bukan diagnosis atau nasihat medis personal. Arahkan gejala menetap/mengkhawatirkan kepada tenaga kesehatan kompeten.</p></div></div></section><section class="teacher-card wide"><span class="section-kicker">SUMBER DAN CATATAN PENYUSUN</span><h2>Rujukan ringkas</h2><p class="source-citation">Diselaraskan dengan proposal skripsi “Pengembangan E-LKPD Berbasis Problem Based Learning (PBL) dengan Pendekatan Deep Learning pada Materi Sistem Saraf Kelas XI di SMA Negeri 11 Medan” — <b>Beatrix Octaviana Silitonga (NIM 4233141016)</b>, Dosen Pembimbing: Prof. Dr. Melva Silitonga, M.S., Program Studi Pendidikan Biologi, Universitas Negeri Medan (UNIMED), 2026. Rujukan materi meliputi OpenStax Anatomy and Physiology 2e, MedlinePlus, WHO, dan CP Biologi Fase F.</p><div class="source-list"><a class="source-link" href="https://openstax.org/details/books/anatomy-and-physiology-2e" target="_blank" rel="noopener">Buku terbuka OpenStax <span>?</span></a><a class="source-link" href="https://medlineplus.gov/" target="_blank" rel="noopener">MedlinePlus <span>?</span></a><a class="source-link" href="https://www.who.int/health-topics/brain-health" target="_blank" rel="noopener">World Health Organization <span>?</span></a></div><div class="notice"><b>Status Produk:</b> Bahan Ajar E-LKPD dikembangkan untuk penelitian tugas akhir skripsi di SMA Negeri 11 Medan.</div></section><section class="teacher-card wide"><span class="section-kicker">KAMUS MINI</span><h2>Glosarium</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Istilah</th><th>Makna ringkas</th></tr></thead><tbody>${[['Akson','Bagian neuron yang menghantarkan impuls menjauhi badan sel.'],['Dendrit','Bagian neuron yang menerima informasi dari sel lain/rangsangan.'],['Impuls saraf','Sinyal yang membawa informasi sepanjang neuron.'],['Neurotransmiter','Pembawa pesan kimia yang dilepaskan pada sinapsis.'],['Sinapsis','Tempat komunikasi antara neuron dengan neuron atau sel sasaran.'],['Sistem saraf pusat','Otak dan sumsum tulang belakang.'],['Sistem saraf tepi','Saraf di luar otak dan sumsum tulang belakang yang menghubungkan pusat dengan tubuh.'],['Gerak refleks','Respons cepat dan otomatis melalui lengkung refleks.'],['Pembelajaran mendalam','Pembelajaran berkesadaran, bermakna, menggembirakan dan mendorong transfer.']].map(r=>`<tr><td><b>${r[0]}</b></td><td>${r[1]}</td></tr>`).join('')}</tbody></table></div></section><section class="teacher-card wide"><button class="button button-outline button-small" data-action="import" type="button">Pulihkan jawaban dari JSON</button> <button class="button button-quiet button-small" data-action="reset" type="button">Hapus data lokal pada perangkat ini</button><p class="small-muted">Ekspor JSON sebelum pindah perangkat. Berkas ini berisi jawaban yang kamu tulis; simpan di lokasi privat.</p></section></div>`;}
function render(){
 document.querySelectorAll('[data-nav]').forEach(b=>b.classList.toggle('active',b.dataset.nav===currentPage));
 const content=document.getElementById('app-content');
 content.innerHTML=currentPage==='home'?renderHome():currentPage==='teacher'?renderTeacher():renderUnit(currentPage);
 updateProgress(); bindCurrent(); updateRubricSummaries(); setConnectivity();
}
function updateProgress(){const n=Object.values(state.completed).filter(Boolean).length;const pct=n/4*100;document.getElementById('progress-fill').style.width=pct+'%';document.getElementById('progress-label').textContent=`${n} dari 4 kegiatan ditandai selesai`;document.querySelectorAll('[data-status]').forEach(el=>el.classList.toggle('done',!!state.completed[el.dataset.status]));const home=document.getElementById('home-done');if(home)home.textContent=`${n}/4`;document.querySelectorAll('.map-card').forEach(c=>c.classList.toggle('done',!!state.completed[c.dataset.nav]));}
function setConnectivity(mode){const el=document.getElementById('connectivity');if(!el)return;if(mode==='memory'){el.classList.add('offline');el.querySelector('span').textContent='Sesi aktif · unduh jawaban';return;}el.classList.toggle('offline',!navigator.onLine);el.querySelector('span').textContent=navigator.onLine?'Autosimpan lokal':'Mode luring · siap belajar';}
function showToast(message){const el=document.getElementById('toast');el.textContent=message;el.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>el.classList.remove('show'),2400);}
function setAnswer(key,value){if(key==='profile.name')state.student.name=value;else if(key==='profile.group')state.student.group=value;else state.answers[key]=value;saveState();}
function updateRubricSummaries(){for(const prefix of ['produk-','proses-']){const ids=prefix==='produk-'?productRows:processRows;const scores=ids.map((_,i)=>Number(state.rubric[prefix+i]||0)).filter(Boolean);const el=document.getElementById(prefix==='produk-'?'product-score':'process-score');if(!el)return;if(scores.length===ids.length){const mean=scores.reduce((a,b)=>a+b,0)/scores.length;const score=Math.round(mean/4*100);el.innerHTML=`Rata-rata <b>${mean.toFixed(2)}/4</b> · konversi ringkas <b>${score}/100</b>. Tinjau deskriptor dan konteks sebelum menentukan tindak lanjut.`;}else{el.textContent=`${scores.length}/${ids.length} aspek telah dinilai. Pilih skor untuk semua aspek.`;}}}
function bindCurrent(){
 document.querySelectorAll('[data-answer]').forEach(el=>{const ev=el.type==='checkbox'?'change':el.tagName==='SELECT'?'change':'input';el.addEventListener(ev,()=>setAnswer(el.dataset.answer,el.type==='checkbox'?el.checked:el.value));});
 document.querySelectorAll('[data-rubric]').forEach(el=>el.addEventListener('change',()=>{state.rubric[el.dataset.rubric]=el.value;saveState();updateRubricSummaries();}));
 document.querySelectorAll('[data-check]').forEach(btn=>btn.addEventListener('click',()=>{const check=CHECKS[btn.dataset.check], pick=document.getElementById(`pick-${btn.dataset.check}`), fb=document.getElementById(`feedback-${btn.dataset.check}`);if(!pick.value){fb.textContent='Pilih jawaban terlebih dahulu.';fb.className='feedback try';return;}const ok=Number(pick.value)===check.correct;fb.textContent=ok?'Tepat. '+check.explain:'Coba lagi. Baca kembali petunjuk konsep, lalu pilih alasan yang paling sesuai.';fb.className='feedback '+(ok?'good':'try');}));
 document.querySelectorAll('[data-action="ngain"]').forEach(btn=>btn.addEventListener('click',calculateNGain));
}
const CHECKS={n1:{correct:1,explain:'Ini arah umum aliran informasi pada neuron; komunikasi sel berikutnya terjadi di sinapsis.'},n2:{correct:1,explain:'Hantaran impuls dipengaruhi sejumlah sifat sel dan kondisi; jangan menyimpulkan dari panjang saja.'},s1:{correct:1,explain:'Neurotransmiter adalah pembawa pesan kimia dalam model sinapsis kimia.'},r1:{correct:1,explain:'Sumsum tulang belakang dapat memediasi respons cepat, sementara informasi tetap dapat diteruskan ke otak.'}};
function calculateNGain(){const pre=Number(val('ngain.pre')),post=Number(val('ngain.post')),max=Number(val('ngain.max')||100),el=document.getElementById('ngain-result');if(!Number.isFinite(pre)||!Number.isFinite(post)||!Number.isFinite(max)||pre<0||post<0||max<=pre||pre>max||post>max){el.innerHTML='Periksa masukan: skor harus 0–maksimum dan maksimum harus lebih besar daripada pretest.';return;}const g=(post-pre)/(max-pre);const cat=g>=.7?'Tinggi':g>=.3?'Sedang':'Rendah';el.innerHTML=`<strong>g = ${g.toFixed(2)} · ${cat}</strong><span>Rumus: (${post} - ${pre}) ÷ (${max} - ${pre}). Interpretasikan dengan konteks desain dan data penelitian sebenarnya.</span>`;}
function download(filename,content,type){const blob=new Blob([content],{type});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=filename;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1000);}
function exportAnswers(){const payload={product:'Jejak Impuls — E-LKPD Sistem Saraf XI (Beatrix Octaviana Silitonga)',version:'1.0-unimed',exportedAt:new Date().toISOString(),student:state.student,answers:state.answers,completed:state.completed,rubric:state.rubric,notice:'Jawaban belajar pribadi. Simpan secara privat; bukan hasil penelitian atau data tervalidasi.'};download('Jejak-Impuls-jawaban.json',JSON.stringify(payload,null,2),'application/json');showToast('Salinan jawaban diunduh. Simpan dengan aman.');}
function importAnswers(file){const reader=new FileReader();reader.onload=()=>{try{const p=JSON.parse(reader.result);if(!p||typeof p!=='object'||!p.answers)throw new Error('format');state={...state,student:{...state.student,...(p.student||{})},answers:{...state.answers,...p.answers},completed:{...state.completed,...(p.completed||{})},rubric:{...state.rubric,...(p.rubric||{})}};saveState();render();showToast('Cadangan jawaban berhasil dipulihkan.');}catch(e){showToast('Berkas tidak dikenali sebagai cadangan Jejak Impuls.');}};reader.readAsText(file);}
function resetData(){if(!confirm('Hapus jawaban, progres, dan skor yang tersimpan di browser/perangkat ini? Tindakan ini tidak dapat dibatalkan. Ekspor cadangan dahulu jika masih diperlukan.'))return;try{localStorage.removeItem(STORAGE_KEY);}catch(e){}state=structuredClone(initialState);render();showToast('Data lokal perangkat ini telah dihapus.');}
document.addEventListener('click',e=>{const nav=e.target.closest('[data-nav]');if(nav){currentPage=nav.dataset.nav;render();document.getElementById('main').focus({preventScroll:true});window.scrollTo({top:0,behavior:'smooth'});return;}const complete=e.target.closest('[data-complete]');if(complete){const id=complete.dataset.complete;state.completed[id]=!state.completed[id];saveState();render();showToast(state.completed[id]?'Kegiatan ditandai selesai.':'Tanda selesai dibatalkan.');return;}const action=e.target.closest('[data-action]');if(!action)return;switch(action.dataset.action){case'export':exportAnswers();break;case'import':document.getElementById('import-file').click();break;case'print':window.print();break;case'reset':resetData();break;case'ngain':calculateNGain();break;}});
document.getElementById('import-file').addEventListener('change',e=>{if(e.target.files?.[0])importAnswers(e.target.files[0]);e.target.value='';});
window.addEventListener('online',()=>setConnectivity());window.addEventListener('offline',()=>setConnectivity());
render();
</script>
